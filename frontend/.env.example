# ---------------------------------------------------------------
# DwellGB frontend configuration — copy to ".env" (or ".env.local").
# Only variables starting with VITE_ are exposed to the browser,
# so NEVER put secrets here. Both values below are PUBLIC keys.
# ---------------------------------------------------------------

# Mapbox public access token (starts with "pk.") — https://account.mapbox.com/access-tokens/
# In the Mapbox dashboard, restrict it to your domains (e.g. http://localhost:5173, https://dwellgb.pk).
VITE_MAPBOX_TOKEN=

# Google OAuth Client ID (same one as GOOGLE_CLIENT_ID in backend/.env)
# Add http://localhost:5173 (and your production URL) to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Leave empty in development (Vite proxies /api to localhost:5000).
# In production, set it only if the API lives on a different domain, e.g. https://api.dwellgb.pk
VITE_API_URL=
