# ---------------------------------------------------------------
# DwellGB backend settings — copy this file to ".env" and fill it in.
# Never commit your real .env file.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Local MongoDB (MongoDB Community Server; view the data with MongoDB Compass)
MONGODB_URI=mongodb://127.0.0.1:27017/dwellgb

# The React app that is allowed to call this API
CLIENT_URLS=http://localhost:5173

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts
JWT_EXPIRES_IN=7d


GOOGLE_CLIENT_ID=
# Mobile app builds (Android / iPhone) have their own Google client IDs — list them here, comma separated.
GOOGLE_APP_CLIENT_IDS=

GEMINI_API_KEY=
